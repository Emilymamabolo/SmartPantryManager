<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF8E7"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_header_food"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Add / Edit Ingredient"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold"
                android:gravity="center" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Track what is already in your kitchen"
                android:textColor="#FFE0B2"
                android:textSize="13sp"
                android:gravity="center"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card_food"
            android:orientation="vertical"
            android:padding="18dp"
            android:elevation="4dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ingredient Name *"
                android:textStyle="bold"
                android:textColor="#212121"
                android:textSize="15sp"
                android:layout_marginBottom="6dp" />

            <EditText
                android:id="@+id/etName"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:hint="e.g. Tomato"
                android:textColor="#212121"
                android:textColorHint="#9E9E9E"
                android:textSize="16sp"
                android:background="#FFF3E0"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:inputType="textCapWords"
                android:maxLines="1"
                android:layout_marginBottom="16dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Quantity *"
                android:textStyle="bold"
                android:textColor="#212121"
                android:textSize="15sp"
                android:layout_marginBottom="6dp" />

            <EditText
                android:id="@+id/etQuantity"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:hint="e.g. 3"
                android:textColor="#212121"
                android:textColorHint="#9E9E9E"
                android:textSize="16sp"
                android:background="#FFF3E0"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:inputType="numberDecimal"
                android:layout_marginBottom="16dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Unit *"
                android:textStyle="bold"
                android:textColor="#212121"
                android:textSize="15sp"
                android:layout_marginBottom="6dp" />

            <Spinner
                android:id="@+id/spinnerUnit"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="#FFF3E0"
                android:paddingStart="8dp"
                android:layout_marginBottom="16dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Expiry Date (optional)"
                android:textStyle="bold"
                android:textColor="#212121"
                android:textSize="15sp"
                android:layout_marginBottom="6dp" />

            <EditText
                android:id="@+id/etExpiry"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:hint="YYYY-MM-DD  e.g. 2026-12-25"
                android:textColor="#212121"
                android:textColorHint="#9E9E9E"
                android:textSize="15sp"
                android:background="#FFF3E0"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:inputType="date"
                android:layout_marginBottom="22dp" />

            <Button
                android:id="@+id/btnSave"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:text="SAVE INGREDIENT"
                android:textAllCaps="true"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:backgroundTint="#5D4037" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
