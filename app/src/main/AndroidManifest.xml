<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@drawable/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SmartPantryManager">

        <activity
            android:name=".PantryListActivity"
            android:exported="true"
            android:label="My Pantry">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".AddEditIngredientActivity"
            android:label="Add / Edit Ingredient"
            android:parentActivityName=".PantryListActivity" />

        <activity
            android:name=".SuggestedRecipesActivity"
            android:label="Suggested Recipes" />

        <activity
            android:name=".RecipeDetailActivity"
            android:label="Recipe Detail"
            android:parentActivityName=".SuggestedRecipesActivity" />

        <activity
            android:name=".SettingsActivity"
            android:label="Settings" />

    </application>
</manifest>
